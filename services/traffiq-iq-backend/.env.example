NODE_ENV=development
PORT=10000
DATABASE_URL=postgresql://user:password@host:5432/traffiq
AUTO_MIGRATE=true
JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=https://traffiq.tukutuku.org,https://traffiqweb.tukutuku.org
PUBLIC_API_BASE_URL=https://api.traffiq.tukutuku.org
PUBLIC_WEB_BASE_URL=https://traffiqweb.tukutuku.org
ROUTING_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=TraffIQ/1.0 (operations@tukutuku.org)
TUKU_CORE_URL=https://core.tukutuku.org
TUKU_ANDROID_REDIRECT_URI=traffiq://auth/tuku/callback
TUKU_CORE_INTERNAL_URL=http://tuku-core-api:3000
